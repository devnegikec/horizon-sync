{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx nx build platform --configuration=production",
  "outputDirectory": "dist/apps/platform",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
