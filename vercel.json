{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "dist/apps/platform",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/inventory/remoteEntry.js",
      "destination": "/inventory/remoteEntry.js"
    },
    {
      "source": "/inventory/((?!remoteEntry\\.js).*)",
      "destination": "/inventory/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
