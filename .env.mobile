# =============================================================================
# Horizon Sync - Mobile App Environment Configuration
# =============================================================================
# Previously using Gateway: https://horizon.ciphercode.ai/api/v1
# Now using direct Railway deployment URLs (bypasses gateway)
# =============================================================================

# --- Identity / Authentication Service ---
# Handles: login, register, refresh, logout, forgot/reset password, OTP, QR login
API_IDENTITY_URL=https://identity-service-production-a1eb.up.railway.app

# --- Core Business Logic Service ---
# Handles: organizations, users, inventory, sourcing, RFQ, purchase orders, etc.
API_CORE_URL=https://core-service-production-66e9.up.railway.app

# --- Search Service ---
# Handles: full-text search across inventory, suppliers, etc.
# NOTE: Currently on ngrok (temporary). Replace with Railway URL once deployed.
API_SEARCH_URL=https://420a-2401-4900-619a-4bf0-89c0-e9f1-13b8-73fc.ngrok-free.app

# --- API Version Prefix ---
# All Railway services serve endpoints under /api/v1/
API_VERSION_PREFIX=/api/v1

# --- Environment ---
ENV=production

# =============================================================================
# ENDPOINT REFERENCE (for mobile app developers)
# =============================================================================
# Login:              POST {API_IDENTITY_URL}/api/v1/identity/login
# Register:           POST {API_IDENTITY_URL}/api/v1/identity/register
# Refresh Token:      POST {API_IDENTITY_URL}/api/v1/identity/refresh
# Logout:             POST {API_IDENTITY_URL}/api/v1/identity/logout
# Forgot Password:    POST {API_IDENTITY_URL}/api/v1/identity/forgot-password
# Reset Password:     POST {API_IDENTITY_URL}/api/v1/identity/reset-password
# QR Code Login:      POST {API_IDENTITY_URL}/api/v1/identity/login/qr-code
# Validate Invite:    GET  {API_IDENTITY_URL}/api/v1/identity/invitations/validate/{token}
# Accept Invite:      POST {API_IDENTITY_URL}/api/v1/identity/invitations/accept
#
# Organizations:      {API_CORE_URL}/api/v1/organizations/...
# Inventory:          {API_CORE_URL}/api/v1/inventory/...
# Sourcing/RFQ:       {API_CORE_URL}/api/v1/sourcing/...
# Purchase Orders:    {API_CORE_URL}/api/v1/purchase-orders/...
# Warehouses:         {API_CORE_URL}/api/v1/warehouses/...
# Suppliers:          {API_CORE_URL}/api/v1/suppliers/...
#
# Search:             {API_SEARCH_URL}/api/v1/search/...
