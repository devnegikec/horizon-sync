{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && npx nx build inventory --configuration=production",
  "outputDirectory": "../../dist/apps/inventory",
  "installCommand": "cd ../.. && npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
