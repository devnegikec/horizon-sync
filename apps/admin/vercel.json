{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx nx build admin --configuration=production",
  "outputDirectory": "dist/apps/admin",
  "installCommand": "npm ci",
  "rootDirectory": "../..",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
